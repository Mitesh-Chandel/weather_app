<%
  const hasWeather = Boolean(weather?.current);
  const current = hasWeather ? weather.current : {};
  const hourly = hasWeather ? weather.hourly : {};
  const daily = hasWeather ? weather.daily : {};
  const conditionCode = current.weather_code ?? daily.weather_code?.[0];
  const condition = conditionCode === undefined
    ? { label: "Weather", type: "cloudy" }
    : (
      conditionCode === 0 ? { label: "Clear sky", type: "sunny" }
        : conditionCode === 1 ? { label: "Mainly clear", type: "sunny" }
          : conditionCode === 2 ? { label: "Partly cloudy", type: "cloudy" }
            : conditionCode === 3 ? { label: "Overcast", type: "cloudy" }
              : [45, 48].includes(conditionCode) ? { label: "Fog", type: "cloudy" }
                : [51, 53, 55, 56, 57].includes(conditionCode) ? { label: "Drizzle", type: "rainy" }
                  : [61, 63, 65, 66, 67, 80, 81, 82].includes(conditionCode) ? { label: "Rain", type: "rainy" }
                    : [71, 73, 75, 77, 85, 86].includes(conditionCode) ? { label: "Snow", type: "snowy" }
                      : [95, 96, 99].includes(conditionCode) ? { label: "Thunderstorm", type: "rainy" }
                        : { label: "Weather conditions", type: "cloudy" }
    );
  const currentTime = current.time || "";
  let firstHour = Array.isArray(hourly.time) ? hourly.time.findIndex((time) => time >= currentTime) : -1;
  if (firstHour < 0) firstHour = 0;
  const hourlyIndices = [];
  for (let i = firstHour; i < (hourly.time?.length || 0) && hourlyIndices.length < 10; i += 2) {
    hourlyIndices.push(i);
  }
  const windDegrees = current.wind_direction_10m;
  const windDirection = Number.isFinite(windDegrees)
    ? ["N", "NE", "E", "SE", "S", "SW", "W", "NW"][Math.round(windDegrees / 45) % 8]
    : null;
  const dayLabel = (date) => date ? new Date(`${date}T12:00:00Z`).toLocaleDateString("en", { weekday: "short", timeZone: "UTC" }) : "";
  const dateLabel = currentTime ? new Date(`${currentTime.slice(0, 10)}T12:00:00Z`).toLocaleDateString("en", { weekday: "long", month: "long", day: "numeric", timeZone: "UTC" }) : "";
  const timeLabel = (dateTime) => dateTime ? dateTime.slice(11, 16) : "";
  const tempUnit = weather?.current_units?.temperature_2m || "°C";
  const windUnit = weather?.current_units?.wind_speed_10m || "km/h";
%>
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#eaf3ff">
  <title><%= place ? `${place.name} weather` : "Atmos — Weather, made clear" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body class="<%= hasWeather ? `weather-${condition.type}` : "" %>">
  <div class="ambient ambient-one" aria-hidden="true"></div>
  <div class="ambient ambient-two" aria-hidden="true"></div>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Atmos home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none"><path d="M7 20.5a8.6 8.6 0 0 1 16.8-2.2 5 5 0 1 1 .2 10H9a4.5 4.5 0 0 1-2-7.8Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M16 3v3m10.2 1.8-2.1 2.1M6.9 7.8 9 9.9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        </span>
        <span>atmos<span class="brand-period">.</span></span>
      </a>

      <form class="search-form" action="/search" method="post" id="searchForm" role="search">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <label class="sr-only" for="city">Search for a city</label>
        <input id="city" name="city" type="search" placeholder="Search any city..." value="<%= search %>" autocomplete="off" required>
        <kbd>Enter</kbd>
        <button class="search-submit" type="submit" aria-label="Search city">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>

      <div class="topbar-actions">
        <form action="/location" method="post" id="locationForm">
          <input type="hidden" name="latitude" id="latitude">
          <input type="hidden" name="longitude" id="longitude">
          <button class="icon-button location-button" type="button" id="locationButton" aria-label="Use current location" title="Use current location">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.7"/></svg>
          </button>
        </form>
        <button class="icon-button theme-button" type="button" id="themeToggle" aria-label="Switch to dark mode" title="Switch theme">
          <svg class="moon-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.2 15.4A8.4 8.4 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg class="sun-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
    </header>

    <main>
      <% if (error) { %>
        <div class="notice notice-error" role="alert">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v4m0 4h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <div class="loading-state" id="loadingState" aria-live="polite">
        <span class="loader"></span>
        <span>Finding your forecast...</span>
      </div>

      <% if (hasWeather) { %>
        <section class="hero-card" aria-label="Current weather">
          <div class="hero-copy">
            <div class="eyebrow"><span class="live-dot"></span> CURRENT WEATHER</div>
            <div class="location-title">
              <h1><%= place.name %></h1>
              <% if (place.country) { %><span class="country-pill"><%= place.country %></span><% } %>
            </div>
            <% if (place.admin1 && place.name !== "Your location") { %><p class="region"><%= place.admin1 %><% if (place.country) { %>, <%= place.country %><% } %></p><% } %>
            <p class="date-line"><%= dateLabel %><% if (currentTime) { %><span class="date-divider">·</span><%= timeLabel(currentTime) %> local time<% } %></p>

            <div class="temperature-line">
              <span class="temperature"><%= Math.round(current.temperature_2m) %><span class="degree"><%= tempUnit %></span></span>
              <span class="condition-text"><%= condition.label %><% if (current.apparent_temperature !== undefined) { %><small>Feels like <%= Math.round(current.apparent_temperature) %><%= tempUnit %></small><% } %></span>
            </div>
            <% if (daily.temperature_2m_max?.[0] !== undefined && daily.temperature_2m_min?.[0] !== undefined) { %>
              <p class="high-low">H:<%= Math.round(daily.temperature_2m_max[0]) %>° <span>·</span> L:<%= Math.round(daily.temperature_2m_min[0]) %>°</p>
            <% } %>
          </div>

          <div class="hero-art" aria-hidden="true">
            <% if (condition.type === "sunny") { %>
              <svg class="weather-illustration sun-illustration" viewBox="0 0 180 180" fill="none"><circle cx="90" cy="90" r="33" fill="url(#sunFill)"/><circle cx="90" cy="90" r="49" stroke="url(#sunStroke)" stroke-width="2" stroke-dasharray="2 13" stroke-linecap="round"/><path d="M90 14v15m0 122v15M14 90h15m122 0h15M36.3 36.3l10.6 10.6m86.2 86.2 10.6 10.6m0-107.4-10.6 10.6m-86.2 86.2-10.6 10.6" stroke="url(#sunStroke)" stroke-width="4" stroke-linecap="round"/><defs><linearGradient id="sunFill" x1="57" y1="50" x2="124" y2="130" gradientUnits="userSpaceOnUse"><stop stop-color="#FFF1A8"/><stop offset="1" stop-color="#FFB648"/></linearGradient><linearGradient id="sunStroke" x1="23" y1="22" x2="153" y2="159" gradientUnits="userSpaceOnUse"><stop stop-color="#FFE28A"/><stop offset="1" stop-color="#FFB449"/></linearGradient></defs></svg>
            <% } else { %>
              <svg class="weather-illustration cloud-illustration" viewBox="0 0 210 170" fill="none"><circle cx="149" cy="51" r="25" fill="url(#cloudSun)" opacity=".9"/><path d="M54 111c-19 0-34-14-34-31s15-31 34-31c6 0 12 2 17 5 8-20 27-34 51-34 30 0 55 23 57 53 18 2 32 17 32 36 0 21-17 38-39 38H55c-19 0-35-15-35-34 0-2 0-2 1-4" fill="url(#cloudFill)" stroke="rgba(255,255,255,.88)" stroke-width="3"/><% if (condition.type === "rainy") { %><path d="m75 137-8 16m40-16-8 16m41-16-8 16" stroke="#90C6FA" stroke-width="5" stroke-linecap="round"/><% } else if (condition.type === "snowy") { %><path d="M73 144v10m-4-7 8 4m0-4-8 4m39-7v10m-4-7 8 4m0-4-8 4m39-7v10m-4-7 8 4m0-4-8 4" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/><% } %><defs><linearGradient id="cloudFill" x1="35" y1="39" x2="172" y2="150" gradientUnits="userSpaceOnUse"><stop stop-color="#fff" stop-opacity=".96"/><stop offset="1" stop-color="#C9E6FF" stop-opacity=".86"/></linearGradient><linearGradient id="cloudSun" x1="125" y1="27" x2="174" y2="76" gradientUnits="userSpaceOnUse"><stop stop-color="#FFF1A8"/><stop offset="1" stop-color="#FFB648"/></linearGradient></defs></svg>
            <% } %>
            <span class="art-glow"></span>
          </div>

          <div class="hero-footer">
            <span class="coordinates"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.3 7-11a7 7 0 1 0-14 0c0 5.7 7 11 7 11Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2" stroke="currentColor" stroke-width="1.6"/></svg><%= Number(place.latitude).toFixed(2) %>°, <%= Number(place.longitude).toFixed(2) %>°<% if (weather.elevation !== undefined) { %><span class="coord-divider">·</span><%= Math.round(weather.elevation) %> m elevation<% } %></span>
            <% if (daily.sunrise?.[0] && daily.sunset?.[0]) { %>
              <span class="sun-times"><span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v2m0 16v2M4.93 4.93l1.4 1.4m11.34 11.34 1.4 1.4M2 12h2m16 0h2M4.93 19.07l1.4-1.4M17.67 5.33l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg> <%= timeLabel(daily.sunrise[0]) %></span><span class="sun-separator">/</span><span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 18h18M5 18a7 7 0 0 1 14 0M12 3v3m-8 2 2 2m14-2-2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg> <%= timeLabel(daily.sunset[0]) %></span></span>
            <% } %>
          </div>
        </section>

        <section class="section-block" aria-labelledby="highlightsTitle">
          <div class="section-heading">
            <div><p class="eyebrow section-eyebrow">THE DETAILS</p><h2 id="highlightsTitle">Today's highlights</h2></div>
            <span class="section-note">Live conditions</span>
          </div>
          <div class="highlights-grid">
            <% if (current.relative_humidity_2m !== undefined) { %>
              <article class="metric-card"><div class="metric-top"><span class="metric-icon tint-blue"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3s7 7.2 7 12a7 7 0 0 1-14 0c0-4.8 7-12 7-12Z" stroke="currentColor" stroke-width="1.7"/><path d="M9 16a3 3 0 0 0 3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span class="metric-label">Humidity</span></div><div class="metric-value"><%= Math.round(current.relative_humidity_2m) %><small>%</small></div><div class="metric-caption">Relative humidity</div><div class="progress-track"><span style="width:<%= Math.max(0, Math.min(100, current.relative_humidity_2m)) %>%"></span></div></article>
            <% } %>
            <% if (current.wind_speed_10m !== undefined) { %>
              <article class="metric-card"><div class="metric-top"><span class="metric-icon tint-violet"><svg viewBox="0 0 24 24" fill="none"><path d="M3 8h12.5a2.5 2.5 0 1 0-2.4-3.2M3 12h16a2 2 0 1 1-1.9 2.6M3 16h9a2 2 0 1 1-1.9 2.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span class="metric-label">Wind</span></div><div class="metric-value"><%= Math.round(current.wind_speed_10m) %><small> <%= windUnit %></small></div><div class="metric-caption"><%= windDirection ? `${windDirection} · ${Math.round(windDegrees)}°` : "Current wind speed" %><% if (current.wind_gusts_10m !== undefined) { %> · Gusts <%= Math.round(current.wind_gusts_10m) %><% } %></div></article>
            <% } %>
            <% if (current.pressure_msl !== undefined) { %>
              <article class="metric-card"><div class="metric-top"><span class="metric-icon tint-amber"><svg viewBox="0 0 24 24" fill="none"><path d="M4 17a8 8 0 1 1 16 0M12 13l4-4M5 17h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="17" r="1" fill="currentColor"/></svg></span><span class="metric-label">Pressure</span></div><div class="metric-value"><%= Math.round(current.pressure_msl) %><small> hPa</small></div><div class="metric-caption">Mean sea level</div></article>
            <% } %>
            <% if (daily.uv_index_max?.[0] !== undefined) { %>
              <article class="metric-card"><div class="metric-top"><span class="metric-icon tint-orange"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span class="metric-label">UV index</span></div><div class="metric-value"><%= Number(daily.uv_index_max[0]).toFixed(1) %></div><div class="metric-caption">Today's maximum</div></article>
            <% } %>
            <% if (current.cloud_cover !== undefined) { %>
              <article class="metric-card"><div class="metric-top"><span class="metric-icon tint-sky"><svg viewBox="0 0 24 24" fill="none"><path d="M7 18h10a4 4 0 0 0 .4-8 6 6 0 0 0-11.6 1.5A3.3 3.3 0 0 0 7 18Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="metric-label">Cloud cover</span></div><div class="metric-value"><%= Math.round(current.cloud_cover) %><small>%</small></div><div class="metric-caption">Sky coverage</div><div class="progress-track"><span style="width:<%= Math.max(0, Math.min(100, current.cloud_cover)) %>%"></span></div></article>
            <% } %>
            <% if (current.precipitation !== undefined) { %>
              <article class="metric-card"><div class="metric-top"><span class="metric-icon tint-blue"><svg viewBox="0 0 24 24" fill="none"><path d="M7 14a4 4 0 0 1 .4-8A6 6 0 0 1 19 7.5 3.5 3.5 0 0 1 18 14m-7 1-2 4m7-4-2 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="metric-label">Precipitation</span></div><div class="metric-value"><%= Number(current.precipitation).toFixed(1) %><small> mm</small></div><div class="metric-caption">Current interval</div></article>
            <% } %>
            <% if (current.surface_pressure !== undefined) { %>
              <article class="metric-card"><div class="metric-top"><span class="metric-icon tint-teal"><svg viewBox="0 0 24 24" fill="none"><path d="M4 19h16M6 16l3-4 3 2 5-7 2 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="metric-label">Surface pressure</span></div><div class="metric-value"><%= Math.round(current.surface_pressure) %><small> hPa</small></div><div class="metric-caption">At local elevation</div></article>
            <% } %>
          </div>
        </section>

        <% if (hourlyIndices.length) { %>
          <section class="section-block forecast-section" aria-labelledby="hourlyTitle">
            <div class="section-heading"><div><p class="eyebrow section-eyebrow">THE NEXT HOURS</p><h2 id="hourlyTitle">Hourly forecast</h2></div><span class="section-note">Local time</span></div>
            <div class="hourly-card">
              <div class="hourly-list">
                <% hourlyIndices.forEach((index) => { const hourCode = hourly.weather_code?.[index]; const hourCondition = hourCode === 0 || hourCode === 1 ? "sun" : [61, 63, 65, 80, 81, 82, 95, 96, 99].includes(hourCode) ? "rain" : "cloud"; %>
                  <article class="hour-item"><span class="hour-time"><%= index === firstHour ? "Now" : timeLabel(hourly.time[index]) %></span><span class="mini-weather <%= hourCondition %>" aria-hidden="true"><% if (hourCondition === "sun") { %><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M12 2v2m0 16v2M4.9 4.9l1.5 1.5m11.2 11.2 1.5 1.5M2 12h2m16 0h2M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><% } else { %><svg viewBox="0 0 24 24" fill="none"><path d="M6.5 16h11a4 4 0 0 0 .4-8 6 6 0 0 0-11.6 1.5A3.3 3.3 0 0 0 6.5 16Z" fill="currentColor" opacity=".8"/><% if (hourCondition === "rain") { %><path d="m9 18-1 2m6-2-1 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><% } %></svg><% } %></span><strong><%= Math.round(hourly.temperature_2m[index]) %>°</strong><% if (hourly.precipitation_probability?.[index] !== undefined) { %><span class="hour-rain"><%= Math.round(hourly.precipitation_probability[index]) %>%</span><% } %></article>
                <% }) %>
              </div>
            </div>
          </section>
        <% } %>

        <% if (daily.time?.length) { %>
          <section class="section-block forecast-section" aria-labelledby="weeklyTitle">
            <div class="section-heading"><div><p class="eyebrow section-eyebrow">PLAN AHEAD</p><h2 id="weeklyTitle">5-day forecast</h2></div><span class="section-note">Daily outlook</span></div>
            <div class="daily-card">
              <% daily.time.forEach((date, index) => { const dayCode = daily.weather_code?.[index]; const dayType = dayCode === 0 || dayCode === 1 ? "sun" : [61, 63, 65, 80, 81, 82, 95, 96, 99].includes(dayCode) ? "rain" : "cloud"; %>
                <article class="day-row"><span class="day-name"><%= index === 0 ? "Today" : dayLabel(date) %><small><%= date.slice(5) %></small></span><span class="day-condition"><span class="mini-weather <%= dayType %>" aria-hidden="true"><% if (dayType === "sun") { %><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M12 2v2m0 16v2M4.9 4.9l1.5 1.5m11.2 11.2 1.5 1.5M2 12h2m16 0h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><% } else { %><svg viewBox="0 0 24 24" fill="none"><path d="M6.5 16h11a4 4 0 0 0 .4-8 6 6 0 0 0-11.6 1.5A3.3 3.3 0 0 0 6.5 16Z" fill="currentColor" opacity=".8"/><% if (dayType === "rain") { %><path d="m9 18-1 2m6-2-1 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><% } %></svg><% } %></span><span><%= dayCode === undefined ? "Forecast" : dayCode === 0 ? "Clear" : dayCode === 1 ? "Mostly clear" : dayCode === 2 ? "Partly cloudy" : dayCode === 3 ? "Cloudy" : [61, 63, 65, 80, 81, 82, 95, 96, 99].includes(dayCode) ? "Rain" : [71, 73, 75, 77, 85, 86].includes(dayCode) ? "Snow" : "Showers" %></span></span><% if (daily.precipitation_probability_max?.[index] !== undefined) { %><span class="day-rain"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3s6 6.2 6 10a6 6 0 0 1-12 0c0-3.8 6-10 6-10Z" stroke="currentColor" stroke-width="1.7"/></svg><%= Math.round(daily.precipitation_probability_max[index]) %>%</span><% } %><div class="temp-range"><span><%= daily.temperature_2m_min?.[index] !== undefined ? Math.round(daily.temperature_2m_min[index]) : "–" %>°</span><div class="range-track"><span></span></div><strong><%= daily.temperature_2m_max?.[index] !== undefined ? Math.round(daily.temperature_2m_max[index]) : "–" %>°</strong></div></article>
              <% }) %>
            </div>
          </section>
        <% } %>
      <% } else if (!error) { %>
        <section class="welcome-card">
          <div class="welcome-orbit orbit-a"></div><div class="welcome-orbit orbit-b"></div>
          <div class="welcome-content"><span class="welcome-icon"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="30" cy="17" r="9" fill="#FFC66D"/><path d="M12 34a7 7 0 0 1 .7-14 11 11 0 0 1 21.2 2.8A6 6 0 0 1 33 34H12Z" fill="white" stroke="#D8E9FC" stroke-width="2"/><path d="M18 38v3m9-3v3" stroke="#9CC8F1" stroke-width="2.5" stroke-linecap="round"/></svg></span><p class="eyebrow">YOUR WEATHER, AT A GLANCE</p><h1>A little more in tune<br>with the <span>weather.</span></h1><p class="welcome-description">Search for a city to see the forecast, live conditions, and the details that help you plan your day.</p><div class="welcome-hint"><span class="hint-dot"></span> Try searching for London, Tokyo, or New York</div></div>
        </section>
      <% } %>
    </main>

    <footer class="footer"><span>Weather data by <a href="https://open-meteo.com/" target="_blank" rel="noreferrer">Open-Meteo</a></span><span>Made for clearer days <span class="footer-spark">✳</span></span></footer>
  </div>

  <script>
    const root = document.documentElement;
    const themeButton = document.getElementById("themeToggle");
    const savedTheme = localStorage.getItem("atmos-theme");
    if (savedTheme === "dark") root.dataset.theme = "dark";
    function updateThemeButton() {
      const isDark = root.dataset.theme === "dark";
      themeButton.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
    }
    updateThemeButton();
    themeButton.addEventListener("click", () => {
      root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
      localStorage.setItem("atmos-theme", root.dataset.theme);
      updateThemeButton();
    });

    const loadingState = document.getElementById("loadingState");
    function showLoading() {
      loadingState.classList.add("visible");
      document.querySelector("main").classList.add("is-loading");
    }
    document.getElementById("searchForm").addEventListener("submit", showLoading);
    document.getElementById("locationForm").addEventListener("submit", showLoading);
    document.getElementById("locationButton").addEventListener("click", () => {
      if (!navigator.geolocation) {
        window.alert("Location is not supported by this browser.");
        return;
      }
      showLoading();
      navigator.geolocation.getCurrentPosition(
        ({ coords }) => {
          document.getElementById("latitude").value = coords.latitude;
          document.getElementById("longitude").value = coords.longitude;
          document.getElementById("locationForm").requestSubmit();
        },
        (error) => {
          loadingState.classList.remove("visible");
          document.querySelector("main").classList.remove("is-loading");
          const message = error.code === error.PERMISSION_DENIED
            ? "Location access was denied. Allow it in your browser settings and try again."
            : "We couldn't determine your location. Please try again.";
          window.alert(message);
        },
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
      );
    });
  </script>
</body>
</html>
